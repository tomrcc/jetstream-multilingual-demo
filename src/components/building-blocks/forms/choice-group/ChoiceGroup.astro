---
import { slugifyLabel } from "@component-utils/slugify";

const {
  name,
  options = [],
  title,
  orientation = "vertical",
  required = false,
  multiple = false,
  class: className,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const inputType = multiple ? "checkbox" : "radio";
const inputName = multiple ? `${name}[]` : name;
---

<fieldset
  class:list={["choice-group", `orientation-${orientation}`, multiple && "multiple", className]}
  role={multiple ? "group" : "radiogroup"}
  data-rosey-ns={_uuid}
  {...htmlAttributes}
>
  {
    title && (
      <legend class="legend">
        {/* Key on the span, not the <legend> — the required marker is a non-text child. */}
        <span data-rosey="title">{title}</span>
        {required && (
          <span
            class="choice-group-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </legend>
    )
  }
  <div class="choice-group-options">
    {
      options.map((option, index) => (
        <label class="choice-group-option">
          <input
            type={inputType}
            name={inputName}
            value={option.value}
            checked={option.checked || false}
            required={required && index === 0}
            aria-required={required && index === 0}
            class="choice-group-field"
          />
          {/* Options are bare {value, label} pairs with no _uuid, so the label is the key. */}
          <span
            class="choice-group-label-text"
            data-rosey={option.label ? `option_${slugifyLabel(option.label)}` : undefined}
          >
            {option.label}
          </span>
        </label>
      ))
    }
  </div>
</fieldset>

<style is:global>
  @layer components {
    .choice-group {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      margin: 0;
      margin-bottom: var(--spacing-md);
      padding: var(--spacing-md);
      width: 100%;

      .choice-group-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }

      .choice-group-options {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
      }

      &.orientation-horizontal .choice-group-options {
        display: grid;
        gap: var(--spacing-sm);
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      }
    }
  }
</style>
