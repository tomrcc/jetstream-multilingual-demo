---
import { slugifyLabel } from "@component-utils/slugify";
import SelectOption from "./SelectOption.astro";

const {
  label,
  name,
  options = [],
  placeholder,
  required = false,
  value,
  class: className,
  id,
  _uuid,
  _component,
  editable = false,
  ...htmlAttributes
} = Astro.props;

const fieldId = id || `select-${crypto.randomUUID()}`;
---

{/* htmlAttributes carries the caller's data-editable/data-component. CloudCannon's
    re-render replaces this element's children with a fresh copy of the component, so
    data-rosey-ns has to sit strictly inside it — on the root it would be re-emitted by
    the copy, doubling the namespace on every key below. */}
<div
  class:list={["select", className]}
  {...htmlAttributes}
>
  {
    label && (
      <label
        for={fieldId}
        class="label"
        data-rosey-ns={_uuid}
      >
        {/* Key on the span, not the <label> — the required marker is a non-text child. */}
        <span data-rosey="label">{label}</span>
        {required && (
          <span
            class="select-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </label>
    )
  }
  <select
    name={name}
    id={fieldId}
    required={required}
    aria-required={required}
    class="field"
    data-rosey-ns={_uuid}
  >
    {
      placeholder && (
        <option
          value=""
          disabled
          data-rosey="placeholder"
        >
          {placeholder}
        </option>
      )
    }
    {
      options.length > 0 ? (
        // Options are bare {value, label} pairs with no _uuid, so the label itself is
        // the key. Repeated labels then share one translation.
        options.map((option) => (
          <SelectOption
            value={option.value}
            label={option.label}
            selected={option.value === value}
            data-rosey={option.label ? `option_${slugifyLabel(option.label)}` : undefined}
          />
        ))
      ) : (
        <slot />
      )
    }
  </select>
</div>

<style>
  @layer components {
    .select {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 100%;
      margin: 0;
      margin-bottom: var(--spacing-md);

      .select-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }
    }
  }
</style>
