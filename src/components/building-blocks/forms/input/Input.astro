---
const {
  label,
  name,
  type = "text",
  placeholder,
  required = false,
  value,
  class: className,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const fieldId = htmlAttributes.id || `input-${crypto.randomUUID()}`;
---

<div
  class:list={["input", className]}
  data-rosey-ns={_uuid}
>
  {
    label && (
      <label
        for={fieldId}
        class="label"
      >
        {/* The key goes on this span, not the <label>: the required marker below is a
            non-text child and would otherwise be captured and injected twice. */}
        <span data-rosey="label">{label}</span>
        {required && (
          <span
            class="input-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </label>
    )
  }
  <input
    type={type}
    name={name}
    id={fieldId}
    placeholder={placeholder}
    required={required}
    aria-required={required}
    value={value}
    class="field"
    data-rosey-attrs-explicit={placeholder ? JSON.stringify({ placeholder: "placeholder" }) : undefined}
    {...htmlAttributes}
  />
</div>

<style>
  @layer components {
    .input {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 100%;
      margin: 0;
      margin-bottom: var(--spacing-md);

      .input-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }
    }
  }
</style>
