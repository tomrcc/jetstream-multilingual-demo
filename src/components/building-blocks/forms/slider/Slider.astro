---
const {
  label,
  name,
  checked = false,
  required = false,
  value = "on",
  class: className,
  id,
  _uuid,
  _component,
  editable = false,
  ...htmlAttributes
} = Astro.props;

const fieldId = id || `slider-${crypto.randomUUID()}`;
---

{/* htmlAttributes carries the caller's data-editable/data-component. CloudCannon's
    re-render replaces this element's children with a fresh copy of the component, so
    data-rosey-ns has to sit strictly inside it — on the root it would be re-emitted by
    the copy, doubling the namespace on every key below. */}
<div
  class:list={["slider", className]}
  {...htmlAttributes}
>
  <label
    class="slider-container"
    for={fieldId}
    data-rosey-ns={_uuid}
  >
    <span class="slider-switch">
      <input
        type="checkbox"
        name={name}
        id={fieldId}
        checked={checked}
        required={required}
        aria-required={required}
        value={value}
        class="slider-input"
      />
      <span class="slider-track"></span>
    </span>
    {
      label && (
        <span class="slider-label">
          {/* Key on the inner span — the required marker is a non-text child. */}
          <span data-rosey="label">{label}</span>
          {required && (
            <span
              class="slider-required"
              aria-label="required"
            >
              *
            </span>
          )}
        </span>
      )
    }
  </label>
</div>

<style>
  @layer components {
    .slider {
      display: flex;
      margin: 0;
      margin-bottom: var(--spacing-md);
      width: 100%;

      .slider-container {
        align-items: center;
        cursor: pointer;
        display: flex;
        gap: var(--spacing-sm);
        width: 100%;
      }

      .slider-label {
        flex: 1;
      }

      .slider-required {
        color: red;
      }

      .slider-switch {
        display: inline-block;
        flex-shrink: 0;
        height: 26px;
        position: relative;
        width: 48px;
      }

      .slider-input {
        height: 0;
        opacity: 0;
        width: 0;
      }

      .slider-track {
        background-color: var(--color-border);
        border-radius: var(--radius-full);
        inset: 0;
        position: absolute;
        transition: var(--animation-normal) cubic-bezier(0.4, 0, 0.2, 1);
      }

      .slider-track::before {
        background-color: var(--color-bg);
        border-radius: var(--radius-full);
        bottom: 3px;
        box-shadow: 0 2px 4px var(--color-state-active);
        content: "";
        height: 20px;
        left: 3px;
        position: absolute;
        transition: var(--animation-normal) cubic-bezier(0.4, 0, 0.2, 1);
        width: 20px;
      }

      .slider-input:checked + .slider-track {
        background: var(--color-bg-inverse);
      }

      .slider-input:checked + .slider-track::before {
        transform: translateX(22px);
      }

      .slider-input:disabled + .slider-track {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
