---
const {
  label,
  name,
  placeholder,
  required = false,
  value,
  class: className,
  id,
  _uuid,
  _component,
  editable = false,
  ...htmlAttributes
} = Astro.props;

const fieldId = id || `textarea-${crypto.randomUUID()}`;
---

{/* htmlAttributes carries the caller's data-editable/data-component, which belong on
    the root element: CloudCannon's re-render nests the component inside the region,
    doubling every data-rosey-ns below it and breaking translation lookups. */}
<div
  class:list={["textarea", className]}
  data-rosey-ns={_uuid}
  {...htmlAttributes}
>
  {
    label && (
      <label
        for={fieldId}
        class="label"
      >
        {/* Key on the span, not the <label> — the required marker is a non-text child. */}
        <span data-rosey="label">{label}</span>
        {required && (
          <span
            class="textarea-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </label>
    )
  }
  <textarea
    name={name}
    id={fieldId}
    placeholder={placeholder}
    required={required}
    aria-required={required}
    class="field"
    data-rosey-attrs-explicit={placeholder ? JSON.stringify({ placeholder: "placeholder" }) : undefined}
    >{value}</textarea
  >
</div>

<style>
  @layer components {
    .textarea {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 100%;
      margin: 0;
      margin-bottom: var(--spacing-md);

      .textarea-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }
    }
  }
</style>
