---
import { resolveRosey } from "@component-utils/roseyKey";

const {
  title,
  text,
  class: className,
  editable = false,
  "data-prop-title": customDataPropTitle,
  "data-prop-content": customDataPropContent,
  "data-rosey-title": roseyTitle,
  "data-rosey-content": roseyContent,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const effectiveTitleProp = customDataPropTitle ?? (editable ? "title" : null);
const titleDataAttributes = effectiveTitleProp
  ? { "data-editable": "text", "data-prop": effectiveTitleProp }
  : {};
const titleRoseyAttributes = resolveRosey(roseyTitle, effectiveTitleProp);

const effectiveContentProp = customDataPropContent ?? (editable ? "text" : null);
const contentDataAttributes = effectiveContentProp
  ? { "data-editable": "text", "data-prop": effectiveContentProp }
  : {};
const contentRoseyAttributes = resolveRosey(roseyContent, effectiveContentProp);

const hasTitle = title?.trim().length > 0;
const hasTitleSlotContent = Astro.slots.has("title");
const hasText = text?.trim().length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && ((!hasTitle && !hasTitleSlotContent) || (!hasText && !hasSlotContent))) return;
---

<div
  class="definition-list-item"
  data-rosey-ns={_uuid}
  {...htmlAttributes}
>
  <dt
    class:list={["title", className]}
    role="term"
  >
    <span
      {...titleDataAttributes}
      {...titleRoseyAttributes}
    >
      <slot name="title">
        {title}
      </slot>
    </span>
  </dt>
  <dd
    class:list={["content", className]}
    role="definition"
  >
    <span
      {...contentDataAttributes}
      {...contentRoseyAttributes}
    >
      <slot>
        {text}
      </slot>
    </span>
  </dd>
</div>

<style>
  @layer components {
    .definition-list-item {
      display: contents;

      .title {
        font-weight: var(--font-weight-bold);
      }
    }
  }
</style>
