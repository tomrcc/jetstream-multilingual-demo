---
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

import type { ContentBlock } from "../types";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    pageSections?: ContentBlock[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  mainNav?: Record<string, unknown>;
  footer?: Record<string, unknown>;
  // Rosey/RCC props. These have to be listed and forwarded explicitly — this layout
  // destructures rather than spreading, so anything missing here silently no-ops.
  roseyRoot?: string;
  roseySeo?: boolean;
  roseyTitleKey?: string;
  roseyDescriptionKey?: string;
  hideLocaleSwitcher?: boolean;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
  roseyRoot,
  roseySeo,
  roseyTitleKey,
  roseyDescriptionKey,
  hideLocaleSwitcher,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const sections = frontmatter?.pageSections ?? [];

// Derived from the URL rather than Astro.params.slug, which is undefined on /blog/,
// /blog/2/, /blog/tag/*/ and 404 — those would all collapse onto the "index" root and
// collide with the home page. Routes serving many pages pass roseyRoot to share one.
const derivedRoseyRoot = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  roseyRoot={roseyRoot ?? derivedRoseyRoot}
  roseySeo={roseySeo}
  roseyTitleKey={roseyTitleKey}
  roseyDescriptionKey={roseyDescriptionKey}
  hideLocaleSwitcher={hideLocaleSwitcher}>
  <MainNavigation {...mainNav} />

  {/* The root sits on <main> so slotted content — blog routes, 404, MDX — is inside it
      too. On the inner wrapper it covered only page-builder sections. */}
  <main data-rosey-root={roseyRoot ?? derivedRoseyRoot}>
    {
      sections.length > 0 && (
        <div
          data-editable="component"
          data-component="utils/main-component"
          data-prop-sections="pageSections">
          <MainComponent sections={sections} />
        </div>
      )
    }
    <slot />
  </main>
  <Footer {...footer} />
</Layout>
